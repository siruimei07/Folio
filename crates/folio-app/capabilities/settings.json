{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "App settings on this computer and the library's ignore rules, for the main window.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-settings",
    "allow-update-app-settings",
    "allow-get-ignore-rules",
    "allow-set-ignore-rules"
  ]
}
