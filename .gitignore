# Agent lane files: shared working directory, never committed (CLAUDE.md §7.3)
.agents/lanes/
# Shared runtime locks, e.g. the app lock (CLAUDE.md §7.5)
.agents/locks/
# Retired work packages, kept as a local archive (CLAUDE.md §7.7)
.agents/work/

# Claude Code per-machine settings
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Dependencies
node_modules/

# Build output
dist/
build/
out/
release/
target/
*.tsbuildinfo
# Tauri-generated capability schemas and command permissions (regenerated by every build)
crates/folio-app/gen/
crates/folio-app/permissions/autogenerated/

# Test output
coverage/
playwright-report/
test-results/

# Local env files
.env
.env.*
!.env.example

# Logs
*.log

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Keys and certificates (e.g. the Tauri updater's signing key); never in a public repository
*.pem
*.key
*.p12
*.pfx

# SQLite side files and archives (handoff bundles, backups)
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm
*.zip

